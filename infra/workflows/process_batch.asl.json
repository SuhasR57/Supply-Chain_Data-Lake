{
    "Comment": "Process one historical supply chain batch",
    "QueryLanguage": "JSONPath",
    "StartAt": "RouteInput",
    "TimeoutSeconds": 900,
    "States": {
        "CheckInput": {
            "Type": "Choice",
            "Choices": [
                {
                    "And": [
                        {
                            "Variable": "$.batch_id",
                            "IsPresent": true
                        },
                        {
                            "Variable": "$.batch_id",
                            "IsString": true
                        },
                        {
                            "Variable": "$.batch_id",
                            "StringMatches": "olist-*"
                        }
                    ],
                    "Next": "RecordStarted"
                }
            ],
            "Default": "InvalidInput"
        },
        "ProcessBatch": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${transform_function_arn}",
                "Payload": {
                    "mode": "s3",
                    "batch_id.$": "$.batch_id"
                }
            },
            "TimeoutSeconds": 180,
            "ResultSelector": {
                "batch_result.$": "$.Payload"
            },
            "ResultPath": "$.processing",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 2,
                    "BackoffRate": 2,
                    "MaxAttempts": 3
                }
            ],
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "ResultPath": "$.failure",
                    "Next": "RecordFailed"
                }
            ],
            "Next": "CheckBatchResult"
        },
        "CheckBatchResult": {
            "Type": "Choice",
            "Choices": [
                {
                    "And": [
                        {
                            "Variable": "$.processing.batch_result.status",
                            "IsPresent": true
                        },
                        {
                            "Variable": "$.processing.batch_result.status",
                            "StringEquals": "complete"
                        }
                    ],
                    "Next": "RecordSucceeded"
                },
                {
                    "And": [
                        {
                            "Variable": "$.processing.batch_result.status",
                            "IsPresent": true
                        },
                        {
                            "Variable": "$.processing.batch_result.status",
                            "StringEquals": "already_processed"
                        }
                    ],
                    "Next": "RecordSucceeded"
                }
            ],
            "Default": "PrepareUnexpectedFailure"
        },
        "BatchCompleted": {
            "Type": "Pass",
            "OutputPath": "$.processing.batch_result",
            "End": true
        },
        "InvalidInput": {
            "Type": "Fail",
            "Error": "InvalidBatchInput",
            "Cause": "Provide a string batch_id beginning with olist-."
        },
        "BatchFailed": {
            "Type": "Fail",
            "Error": "BatchProcessingFailed",
            "Cause": "Lambda processing failed. Inspect ProcessBatch in the execution history."
        },
        "RecordStarted": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Parameters": {
                "TableName": "${batch_runs_table_name}",
                "Key": {
                    "batch_id": {
                        "S.$": "$.batch_id"
                    },
                    "execution_id": {
                        "S.$": "$$.Execution.Id"
                    }
                },
                "UpdateExpression": "SET #status = :status, started_at = if_not_exists(started_at, :started)",
                "ExpressionAttributeNames": {
                    "#status": "status"
                },
                "ExpressionAttributeValues": {
                    ":status": {
                        "S": "running"
                    },
                    ":started": {
                        "S.$": "$$.Execution.StartTime"
                    }
                }
            },
            "ResultPath": null,
            "Next": "ProcessBatch"
        },
        "RecordSucceeded": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Parameters": {
                "TableName": "${batch_runs_table_name}",
                "Key": {
                    "batch_id": {
                        "S.$": "$.batch_id"
                    },
                    "execution_id": {
                        "S.$": "$$.Execution.Id"
                    }
                },
                "UpdateExpression": "SET #status = :status, finished_at = :finished",
                "ExpressionAttributeNames": {
                    "#status": "status"
                },
                "ExpressionAttributeValues": {
                    ":status": {
                        "S.$": "$.processing.batch_result.status"
                    },
                    ":finished": {
                        "S.$": "$$.State.EnteredTime"
                    }
                }
            },
            "ResultPath": null,
            "Next": "BatchCompleted"
        },
        "PrepareUnexpectedFailure": {
            "Type": "Pass",
            "Result": {
                "Error": "UnexpectedBatchResult",
                "Cause": "Lambda returned an unsupported processing status."
            },
            "ResultPath": "$.failure",
            "Next": "RecordFailed"
        },
        "RecordFailed": {
            "Type": "Task",
            "Resource": "arn:aws:states:::dynamodb:updateItem",
            "Parameters": {
                "TableName": "${batch_runs_table_name}",
                "Key": {
                    "batch_id": {
                        "S.$": "$.batch_id"
                    },
                    "execution_id": {
                        "S.$": "$$.Execution.Id"
                    }
                },
                "UpdateExpression": "SET #status = :status, finished_at = :finished, #error = :error",
                "ExpressionAttributeNames": {
                    "#status": "status",
                    "#error": "error"
                },
                "ExpressionAttributeValues": {
                    ":status": {
                        "S": "failed"
                    },
                    ":finished": {
                        "S.$": "$$.State.EnteredTime"
                    },
                    ":error": {
                        "S.$": "$.failure.Error"
                    }
                }
            },
            "ResultPath": null,
            "Next": "BatchFailed"
        },
        "RouteInput": {
            "Type": "Choice",
            "Choices": [
                {
                    "And": [
                        {
                            "Variable": "$.raw_manifest_key",
                            "IsPresent": true
                        },
                        {
                            "Variable": "$.raw_manifest_key",
                            "IsString": true
                        },
                        {
                            "Variable": "$.raw_manifest_key",
                            "StringMatches": "batches/olist-*/manifest.json"
                        }
                    ],
                    "Next": "NormalizeManifestEvent"
                }
            ],
            "Default": "CheckInput"
        },
        "NormalizeManifestEvent": {
            "Type": "Pass",
            "Parameters": {
                "batch_id.$": "States.ArrayGetItem(States.StringSplit($.raw_manifest_key, '/'), 1)",
                "raw_manifest_key.$": "$.raw_manifest_key",
                "expected_manifest_key.$": "States.Format('batches/{}/manifest.json', States.ArrayGetItem(States.StringSplit($.raw_manifest_key, '/'), 1))"
            },
            "Next": "CheckManifestPath"
        },
        "CheckManifestPath": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.raw_manifest_key",
                    "StringEqualsPath": "$.expected_manifest_key",
                    "Next": "CheckInput"
                }
            ],
            "Default": "InvalidInput"
        }
    }
}